{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "gunicorn ErrandM8.wsgi --log-file -",
    "preDeployCommand": "python manage.py migrate --noinput",
    "preDeployTimeoutSeconds": 180,
    "restartPolicyType": "ON_FAILURE"
  }
}
